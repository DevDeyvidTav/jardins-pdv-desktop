{
  "name": "@pdv/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "PDV Restaurante — aplicativo desktop Electron",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "rebuild:native": "node scripts/rebuild-better-sqlite3-electron.js",
    "seed:apresentacao": "vitest run --config vitest.seed.config.ts",
    "seed:fiscal-produtos": "vitest run --config vitest.seed.config.ts tests/seed/preencher-fiscal-produtos.seed.ts",
    "gen:china-express": "python scripts/gerar-china-express-catalogo.py",
    "seed:china-express": "vitest run --config vitest.seed.config.ts tests/seed/china-express.seed.ts",
    "icons": "node scripts/gerar-icone-instalador.mjs",
    "dist:win": "npm run icons && npm run rebuild:native && electron-vite build && electron-builder --win --publish never",
    "dist:win:publish": "npm run icons && npm run rebuild:native && electron-vite build && electron-builder --win --publish always",
    "build:win": "npm run dist:win",
    "dist": "npm run dist:win"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "electron-updater": "^6.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uqr": "^0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.51.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "jimp": "^1.6.1",
    "to-ico": "^1.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  },
  "build": {
    "appId": "com.jardins.pdv",
    "productName": "Jardins PDV",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Jardins-PDV-${version}-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jardins PDV",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "DevDeyvidTav",
      "repo": "jardins-pdv-desktop",
      "releaseType": "release"
    }
  }
}
